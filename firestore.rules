rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }

    function isAdminUser() {
      return isAuthed()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // One document per admin UID — create manually in Console: admins/{uid}
    match /admins/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow write: if false;
    }

    match /properties/{propertyId} {
      allow read: if resource.data.status == 'approved'
        || isAdminUser()
        || (isAuthed() && resource.data.ownerId == request.auth.uid);

      allow create: if isAuthed()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isAdminUser()
        || (
          isAuthed()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.status == resource.data.status
        );

      allow delete: if isAdminUser()
        || (isAuthed() && resource.data.ownerId == request.auth.uid);
    }

    match /interests/{id} {
      allow create: if request.resource.data.keys().hasAll(['propertyId', 'propertyTitle', 'name', 'phone'])
        && request.resource.data.propertyId is string
        && request.resource.data.name is string
        && request.resource.data.phone is string;
      allow read: if isAdminUser();
      allow update, delete: if isAdminUser();
    }

    match /propertyViews/{id} {
      allow create: if request.resource.data.keys().hasAll(['propertyId'])
        && request.resource.data.propertyId is string;
      allow read: if isAdminUser();
      allow update, delete: if isAdminUser();
    }

    match /users/{userId} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
    }
  }
}
